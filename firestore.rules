rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Passcode ID Poisoning protection
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper syntax wrappers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validate schedule document format
    function isValidSchedule(data) {
      return data.keys().hasAll(['passcode', 'drivers', 'locks', 'updatedAt'])
        && data.keys().size() == 4
        && data.passcode is string
        && data.passcode.size() <= 64
        && data.drivers is list
        && data.drivers.size() <= 100
        && data.locks is map
        && data.updatedAt == request.time;
    }

    // Roster Collection
    match /schedules/{passcode} {
      // Get document when passcode matches
      allow get: if isValidId(passcode);
      
      // Dynamic creation or update is allowed if passcode matches document ID and is valid format
      allow create: if isValidId(passcode) && isValidSchedule(incoming()) && incoming().passcode == passcode;
      allow update: if isValidId(passcode) && isValidSchedule(incoming()) && incoming().passcode == passcode;
      
      // Prevent public listing or raw deletions
      allow list, delete: if false;
    }
  }
}
